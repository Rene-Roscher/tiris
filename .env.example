# Tapo / TP-Link account the plugs are bound to. Used locally for the plug handshake only.
TIRIS_TAPO_USERNAME=you@example.com
TIRIS_TAPO_PASSWORD=change-me

# Where discovery looks: your subnet broadcast and/or fixed plug IPs, comma separated.
TIRIS_DISCOVERY_TARGETS=192.168.1.255

# Optional: password for the web UI. Empty = no login (fine on a trusted home network).
TIRIS_PASSWORD=

# Database password (docker compose creates the database with it on first start).
POSTGRES_PASSWORD=tiris

# TIRIS_TIMEZONE=Europe/Berlin
# TIRIS_LIVE_INTERVAL_S=2          # plugs update their power value about every 1.5 s
# TIRIS_COLLECT_INTERVAL_MIN=15
# TIRIS_RAW_RETENTION_DAYS=365     # raw 2-second samples; aggregates are kept forever
# TIRIS_PORT=8080
